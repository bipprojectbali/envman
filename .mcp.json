{
  "mcpServers": {
    "deploy-stg": {
      "command": "bun",
      "args": ["run", "scripts/mcp/deploy.ts"],
      "env": {
        "STACK_NAME": "envman",
        "BASE_URL": "https://envman.wibudev.com",
        "ENV": "stg",
        "GH_TOKEN": "${GH_TOKEN}",
        "GH_REPO": "bipprojectbali/envman"
      },
      "description": "Deploy pipeline ke staging"
    },
    "playwright": {
      "command": "bunx",
      "args": ["@playwright/mcp@latest"]
    },
    "app-mcp": {
      "command": "bun",
      "args": ["run", "scripts/mcp/server.ts"],
      "env": {
        "MCP_SECRET": "${MCP_SECRET}"
      }
    }
  }
}
