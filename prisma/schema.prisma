generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  QC
  ADMIN
  SUPER_ADMIN
}

enum ProjectMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  READY_FOR_QC
  REOPENED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  password      String?
  image         String?
  role          Role      @default(USER)
  blocked       Boolean   @default(false)
  permissions   String[]  @default([])
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions              Session[]
  accounts              Account[]
  auditLogs             AuditLog[]
  reported              Ticket[]              @relation("TicketReporter")
  assigned              Ticket[]              @relation("TicketAssignee")
  portainerConnections  PortainerConnection[]
  portainerSyncLogs     PortainerSyncLog[]
  comments              TicketComment[]
  projectMembers        ProjectMember[]
  envMemberships        EnvironmentMember[]
  apiTokens             ApiToken[]
  notes                 ProjectNote[]
  projectAliases        ProjectAlias[]  @relation("ProjectAliasCreator")
  projectFiles          ProjectFile[]   @relation("ProjectFileAuthor")
  gists                 Gist[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model Ticket {
  id          String         @id @default(uuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  route       String?
  reporterId  String
  assigneeId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  closedAt    DateTime?

  reporter User             @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments TicketComment[]
  evidence TicketEvidence[]

  @@index([status])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([createdAt])
  @@map("ticket")
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String?
  authorTag String
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("ticket_comment")
}

model TicketEvidence {
  id        String   @id @default(uuid())
  ticketId  String
  kind      String
  url       String
  note      String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_evidence")
}

// ─── Gists ────────────────────────────────────────────────────────────────────

model Gist {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String   @default("")
  files       Json     // [{ filename, content, language }]
  isPublic    Boolean  @default(false)
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic])
  @@map("gist")
}

// ─── Env Manager ──────────────────────────────────────────────────────────────

model ProjectNote {
  id        String   @id @default(uuid())
  projectId String
  authorId  String
  title     String
  body      String
  pinned    Boolean  @default(false)
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([authorId])
  @@map("project_note")
}

model ProjectAlias {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  args        String
  description String?
  tags        String[] @default([])
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation("ProjectAliasCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_alias")
}

model ProjectFile {
  id          String   @id @default(uuid())
  projectId   String
  authorId    String
  title       String
  description String   @default("")
  files       Json
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("ProjectFileAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([authorId])
  @@map("project_file")
}

model Project {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  tags        String[]  @default([])
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members           ProjectMember[]
  environments      Environment[]
  portainerConfigs  PortainerConfig[]
  notes             ProjectNote[]
  aliases           ProjectAlias[]
  projectFiles      ProjectFile[]

  @@index([deletedAt])
  @@map("project")
}

model Environment {
  id        String   @id @default(uuid())
  name      String
  projectId String
  createdAt DateTime @default(now())

  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vars    EnvVar[]
  members EnvironmentMember[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("environment")
}

model EnvVar {
  id            String   @id @default(uuid())
  key           String
  value         String
  isSecret      Boolean  @default(false)
  isDisabled    Boolean  @default(false)
  environmentId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, key])
  @@index([environmentId])
  @@map("env_var")
}

model ProjectMember {
  id        String            @id @default(uuid())
  userId    String
  projectId String
  role      ProjectMemberRole @default(VIEWER)
  createdAt DateTime          @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("project_member")
}

model EnvironmentMember {
  id            String             @id @default(uuid())
  userId        String
  environmentId String
  // null = explicit DENY (override project default ke "no access")
  // OWNER/EDITOR/VIEWER = override role
  // tidak ada record = inherit project role
  role          ProjectMemberRole?
  createdAt     DateTime           @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([userId, environmentId])
  @@index([environmentId])
  @@map("environment_member")
}

model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  token      String    @unique
  scopes     String[]  @default([])
  canWrite   Boolean   @default(false)
  isDisabled Boolean   @default(false)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("api_token")
}

model PortainerConnection {
  id           String    @id @default(uuid())
  name         String
  portainerUrl String
  apiToken     String
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy      User                   @relation(fields: [createdById], references: [id])
  configs        PortainerConfig[]
  stackTargets   PortainerStackTarget[]

  @@map("portainer_connection")
}

model PortainerConfig {
  id           String    @id @default(uuid())
  projectId    String
  envName      String
  connectionId String?
  portainerUrl String?
  apiToken     String?
  stackId      Int
  stackName    String
  endpointId   Int       @default(1)
  lastSyncAt   DateTime?
  lastSyncOk   Boolean?
  autoSync     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection       PortainerConnection?   @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  syncLogs         PortainerSyncLog[]
  additionalTargets PortainerStackTarget[]

  @@unique([projectId, envName])
  @@index([connectionId])
  @@map("portainer_config")
}

model PortainerSyncLog {
  id          String   @id @default(uuid())
  configId    String
  userId      String?
  triggeredBy String   // "manual" | "auto"
  varsCount   Int
  secretCount Int      @default(0)
  ok          Boolean
  error       String?
  durationMs  Int?
  createdAt   DateTime @default(now())

  config PortainerConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  user   User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([configId])
  @@map("portainer_sync_log")
}

model PortainerStackTarget {
  id           String   @id @default(uuid())
  configId     String
  connectionId String?
  stackId      Int
  stackName    String
  endpointId   Int      @default(1)
  label        String?
  createdAt    DateTime @default(now())

  config     PortainerConfig     @relation(fields: [configId], references: [id], onDelete: Cascade)
  connection PortainerConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([configId])
  @@map("portainer_stack_target")
}
