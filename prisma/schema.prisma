generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ProjectMemberRole {
  OWNER
  EDITOR
  VIEWER
}

// Section non-env yang bisa diberi override akses per-member (analog EnvironmentMember).
enum ProjectSection {
  NOTES
  ALIASES
  FILES
  STORAGE
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  password      String?
  image         String?
  role          Role      @default(USER)
  blocked       Boolean   @default(false)
  permissions   String[]  @default([])
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions              Session[]
  accounts              Account[]
  auditLogs             AuditLog[]
  portainerConnections  PortainerConnection[]
  portainerSyncLogs     PortainerSyncLog[]
  portainerBackups      PortainerBackup[]     @relation("PortainerBackupCreator")
  projectMembers        ProjectMember[]
  envMemberships        EnvironmentMember[]
  sectionMemberships    ProjectSectionMember[]
  apiTokens             ApiToken[]
  notes                 ProjectNote[]
  projectAliases        ProjectAlias[]  @relation("ProjectAliasCreator")
  projectFiles          ProjectFile[]   @relation("ProjectFileAuthor")
  gists                 Gist[]
  storageUploads        ProjectStorageObject[]
  createdProjects       Project[]             @relation("ProjectCreator")
  clipboard             Clipboard?

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── Gists ────────────────────────────────────────────────────────────────────

model Gist {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String   @default("")
  files       Json     // [{ filename, content, language }]
  isPublic    Boolean  @default(false)
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // title is a natural key per user so the CLI (`envman gists push <name>`) can
  // resolve a gist by name instead of UUID.
  @@unique([userId, title])
  @@index([userId])
  @@index([isPublic])
  @@map("gist")
}

// Account-scoped single-slot clipboard (like pbcopy/pbpaste, synced across
// devices). One row per user (userId is PK). Content is encrypted at rest and
// auto-expires at expiresAt (default 24h). See src/routes/envman/clipboard.ts.
model Clipboard {
  userId    String   @id
  content   String   // encrypted: enc:iv:cipher:tag (src/lib/crypto.ts)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("clipboard")
}

// ─── Env Manager ──────────────────────────────────────────────────────────────

model ProjectNote {
  id        String   @id @default(uuid())
  projectId String
  authorId  String
  title     String
  body      String
  pinned    Boolean  @default(false)
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([authorId])
  @@map("project_note")
}

model ProjectAlias {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  args        String
  description String?
  tags        String[] @default([])
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation("ProjectAliasCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_alias")
}

model ProjectFile {
  id          String   @id @default(uuid())
  projectId   String
  authorId    String
  title       String
  description String   @default("")
  files       Json
  prefix      String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("ProjectFileAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([projectId, prefix])
  @@index([projectId])
  @@index([authorId])
  @@map("project_file")
}

model Project {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  tags        String[]  @default([])
  icon        String?   // nama Tabler icon (mis. "TbCloud") untuk avatar; null = inisial nama
  color       String?   // nama warna Mantine (mis. "grape") untuk bg avatar; null = warna-by-role
  cardColor   String?   // nama warna Mantine untuk tint background card; null = tanpa tint
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  storageQuotaMb    Int?      // null = pakai AppSetting storage_default_quota_mb (default 500)
  storageMaxFileMb  Int?      // null = pakai AppSetting storage_max_file_mb (default 50)

  createdById String?   // user pembuat project; null untuk project lama tanpa data pembuat
  createdBy   User?     @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members           ProjectMember[]
  sectionMembers    ProjectSectionMember[]
  environments      Environment[]
  portainerConfigs  PortainerConfig[]
  notes             ProjectNote[]
  aliases           ProjectAlias[]
  projectFiles      ProjectFile[]
  storageObjects    ProjectStorageObject[]

  @@index([deletedAt])
  @@index([createdById])
  @@map("project")
}

model ProjectStorageObject {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path         String   // path relatif user, mis. "assets/logo.png"
  minioKey     String   // key di MinIO: "{projectId}/{path}"
  size         Int      // bytes
  mimeType     String   @default("application/octet-stream")
  isPublic     Boolean  @default(false)
  tags         String[] @default([])
  description  String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, path])
  @@index([projectId])
  @@map("project_storage_object")
}

model Environment {
  id        String   @id @default(uuid())
  name      String
  tags      String[] @default([])
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vars    EnvVar[]
  members EnvironmentMember[]

  importsInto EnvImport[] @relation("EnvImportTarget")
  importedBy  EnvImport[] @relation("EnvImportSource")

  @@unique([projectId, name])
  @@index([projectId])
  @@map("environment")
}

// Live-link import: env target meminjam vars dari source env (lintas project).
// Vars di-resolve live saat dibaca (bukan snapshot) untuk mencegah drift.
model EnvImport {
  id          String   @id @default(uuid())
  targetEnvId String
  sourceEnvId String
  order       Int      @default(0)
  keys        String[] @default([]) // whitelist key yang di-import; kosong = semua var source ikut
  createdById String
  createdAt   DateTime @default(now())

  targetEnv Environment @relation("EnvImportTarget", fields: [targetEnvId], references: [id], onDelete: Cascade)
  sourceEnv Environment @relation("EnvImportSource", fields: [sourceEnvId], references: [id], onDelete: Cascade)

  @@unique([targetEnvId, sourceEnvId])
  @@index([targetEnvId])
  @@index([sourceEnvId])
  @@map("env_import")
}

model EnvVar {
  id            String   @id @default(uuid())
  key           String
  value         String
  isSecret      Boolean  @default(false)
  isDisabled    Boolean  @default(false)
  environmentId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, key])
  @@index([environmentId])
  @@map("env_var")
}

model ProjectMember {
  id        String            @id @default(uuid())
  userId    String
  projectId String
  role      ProjectMemberRole @default(VIEWER)
  createdAt DateTime          @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("project_member")
}

model EnvironmentMember {
  id            String             @id @default(uuid())
  userId        String
  environmentId String
  // null = explicit DENY (override project default ke "no access")
  // OWNER/EDITOR/VIEWER = override role
  // tidak ada record = inherit project role
  role          ProjectMemberRole?
  createdAt     DateTime           @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([userId, environmentId])
  @@index([environmentId])
  @@map("environment_member")
}

// Override akses per-member untuk section non-env (Notes/Aliases/Files/Storage).
// Semantik identik EnvironmentMember:
//   null = explicit DENY · OWNER/EDITOR/VIEWER = override · tidak ada record = inherit project role
model ProjectSectionMember {
  id        String            @id @default(uuid())
  userId    String
  projectId String
  section   ProjectSection
  role      ProjectMemberRole?
  // Tag scope untuk limit-by-tag di dalam section. Kosong [] = full access
  // (lihat semua item, termasuk yang tak bertag). Non-kosong = hanya item yang
  // punya ≥1 tag ini (match OR). Item tanpa tag hanya untuk full-access member.
  scopeTags String[]          @default([])
  createdAt DateTime          @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, section])
  @@index([projectId])
  @@map("project_section_member")
}

model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  token      String    @unique
  scopes     String[]  @default([])
  tags       String[]  @default([])
  canWrite   Boolean   @default(false)
  isDisabled     Boolean   @default(false)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  useCount       Int       @default(0)
  lastIp         String?
  disabledBy     String?
  disabledAt     DateTime?
  disabledReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("api_token")
}

model PortainerConnection {
  id           String    @id @default(uuid())
  name         String
  portainerUrl String
  apiToken     String
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy      User                      @relation(fields: [createdById], references: [id])
  configs        PortainerConfig[]
  stackTargets   PortainerStackTarget[]
  backups        PortainerBackup[]
  backupSchedule PortainerBackupSchedule?

  @@map("portainer_connection")
}

model PortainerConfig {
  id           String    @id @default(uuid())
  projectId    String
  envName      String
  connectionId String?
  portainerUrl String?
  apiToken     String?
  stackId      Int
  stackName    String
  endpointId   Int       @default(1)
  lastSyncAt   DateTime?
  lastSyncOk   Boolean?
  autoSync     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection       PortainerConnection?   @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  syncLogs         PortainerSyncLog[]
  additionalTargets PortainerStackTarget[]

  @@unique([projectId, envName])
  @@index([connectionId])
  @@map("portainer_config")
}

model PortainerSyncLog {
  id          String   @id @default(uuid())
  configId    String
  userId      String?
  triggeredBy String   // "manual" | "auto"
  varsCount   Int
  secretCount Int      @default(0)
  ok          Boolean
  error       String?
  durationMs  Int?
  createdAt   DateTime @default(now())

  config PortainerConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  user   User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([configId])
  @@map("portainer_sync_log")
}

model PortainerStackTarget {
  id           String   @id @default(uuid())
  configId     String
  connectionId String?
  stackId      Int
  stackName    String
  endpointId   Int      @default(1)
  label        String?
  createdAt    DateTime @default(now())

  config     PortainerConfig     @relation(fields: [configId], references: [id], onDelete: Cascade)
  connection PortainerConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([configId])
  @@map("portainer_stack_target")
}

enum PortainerBackupType {
  PORTAINER_DB
  COMPOSE_FILES
  FULL
}

model PortainerBackup {
  id           String              @id @default(uuid())
  connectionId String
  type         PortainerBackupType @default(PORTAINER_DB)
  note         String?
  sizeBytes    Int?
  data         Bytes
  ok           Boolean
  error        String?
  createdById  String?
  createdAt    DateTime            @default(now())

  connection PortainerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdBy  User?               @relation("PortainerBackupCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([connectionId])
  @@index([createdAt])
  @@map("portainer_backup")
}

model PortainerBackupSchedule {
  id           String              @id @default(uuid())
  connectionId String              @unique
  cron         String
  type         PortainerBackupType @default(PORTAINER_DB)
  note         String?
  enabled      Boolean             @default(true)
  lastRunAt    DateTime?
  lastRunOk    Boolean?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  connection PortainerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("portainer_backup_schedule")
}

// ─── Migration Test Fixture ───────────────────────────────────────────────────
// Tabel ini dipakai untuk menguji mekanisme migrasi (custom migrator + Prisma compat).
// Sengaja mencakup berbagai tipe kolom: enum, json, array, float, nullable, index.

enum TestMigrateKind {
  ALPHA
  BETA
  GAMMA
}

model TestMigrate {
  id         String          @id @default(uuid())
  label      String
  slug       String          @unique
  count      Int             @default(0)
  score      Float?
  active     Boolean         @default(true)
  kind       TestMigrateKind @default(ALPHA)
  meta       Json?
  tags       String[]        @default([])
  note       String?
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([kind])
  @@index([active])
  @@index([createdAt])
  @@map("test_migrate")
}

model AppSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("app_setting")
}

model TokenActivityLog {
  id          String   @id @default(uuid())
  tokenId     String
  userId      String?
  tokenName   String?
  action      String
  projectSlug String?
  envName     String?
  detail      String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([tokenId])
  @@index([userId])
  @@index([createdAt])
  @@map("token_activity_log")
}
